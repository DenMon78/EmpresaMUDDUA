<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MUDDUA</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Fuente mejorada -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- CSS del sitio -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/principal.css" asp-append-version="true" />
</head>
<body>

    <!-- ── NAVBAR ─────────────────────────────────────────── -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top" id="main-navbar">
            <div class="container">

                <!-- Logo -->
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold"
                   asp-controller="Home" asp-action="Index">
                    <div class="logo-dot"></div>
                    MUDDUA
                </a>

                <!-- Botón móvil -->
                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <i class="bi bi-list fs-4"></i>
                </button>

                <!-- Links -->
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav mx-auto gap-1">
                        <!--<li class="nav-item">
                            <a class="nav-link nav-pill-link" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>-->
                        <li class="nav-item">
                            <a class="nav-link nav-pill-link" asp-controller="Home" asp-action="Servicios">Servicios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-pill-link" asp-controller="Home" asp-action="Nosotros">Nosotros</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-pill-link" asp-controller="Home" asp-action="Equipo">Equipo</a>
                        </li>
                        <!--<li class="nav-item">
                            <a class="nav-link nav-pill-link" asp-controller="Home" asp-action="Contacto">Contacto</a>
                        </li>-->
                    </ul>
                    <a class="btn btn-dark btn-muddua ms-3 mt-2 mt-lg-0"
                       asp-controller="Home" asp-action="Contacto">
                        <i class="bi bi-rocket-takeoff me-1"></i> Comenzar proyecto
                    </a>
                </div>

            </div>
        </nav>
    </header>

    <!-- ── CONTENIDO ──────────────────────────────────────── -->
    <main>
        @RenderBody()
    </main>

    <!-- ── FOOTER ─────────────────────────────────────────── -->
    <footer class="footer-muddua pt-5 pb-4 mt-5">
        <div class="container">
            <div class="row g-4">

                <!-- Marca y descripción -->
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="logo-dot logo-dot-sm"></div>
                        <span class="fw-bold text-white fs-5">MUDDUA</span>
                    </div>
                    <p class="footer-tagline">
                        Mente · Unión · Diseño · Desarrollo · Utilidad · Avance.<br />
                        Tu socio tecnológico de confianza.
                    </p>
                    <!-- Redes sociales -->
                    <div class="d-flex gap-2 mt-3">
                        <a href="https://github.com/Gary750/Ring_salud" class="footer-social"><i class="bi bi-github"></i></a>
                    </div>
                </div>

                <!-- Empresa -->
                <div class="col-6 col-lg-2">
                    <h6 class="footer-heading">Empresa</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Nosotros">Nosotros</a></li>
                        <li><a asp-controller="Home" asp-action="Equipo">Equipo</a></li>
                        <li><a asp-controller="Home" asp-action="Servicios">Servicios</a></li>
                        <li><a asp-controller="Home" asp-action="Contacto">Contacto</a></li>
                    </ul>
                </div>

                <!-- Servicios -->
                <div class="col-6 col-lg-3">
                    <h6 class="footer-heading">Servicios</h6>
                    <ul class="footer-links">
                        <li><a href="#">Desarrollo Web</a></li>
                        <li><a href="#">Apps Móviles</a></li>
                        <li><a href="#">Bases de Datos</a></li>
                        <li><a href="#">Diseño UI/UX</a></li>
                        <li><a href="#">Ciberseguridad & Datos</a></li>
                    </ul>
                </div>

                <!-- Contacto -->
                <div class="col-lg-3">
                    <h6 class="footer-heading">Contacto</h6>
                    <ul class="footer-contact">
                        <li>
                            <i class="bi bi-envelope-fill text-primary"></i>
                            <!-- ⚠️ Cambia por tu correo real -->
                            <a href="mailto:contacto@muddua.com">contacto@muddua.com</a>
                        </li>
                        <li>
                            <i class="bi bi-whatsapp text-success"></i>
                            <!-- ⚠️ Cambia por tu número real -->
                            <a href="#">+52 771 000 0000</a>
                        </li>
                        <li>
                            <i class="bi bi-geo-alt-fill text-danger"></i>
                            <!-- ⚠️ Cambia por tu ubicación real -->
                            <span>Hidalgo, México</span>
                        </li>
                    </ul>
                </div>

            </div>

            <!-- Línea inferior -->
            <hr class="footer-divider mt-4 mb-3" />
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <small class="footer-copy">© @DateTime.Now.Year MUDDUA. Todos los derechos reservados.</small>
                <div class="d-flex gap-3">
                    <a href="#" class="footer-copy footer-link-sm">Privacidad</a>
                    <a href="#" class="footer-copy footer-link-sm">Términos</a>
                </div>
            </div>

        </div>
    </footer>

    <!-- ── SCRIPTS ─────────────────────────────────────────── -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>