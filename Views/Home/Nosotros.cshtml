@{
    ViewData["Title"] = "Nosotros";
}

<!-- ── HERO INTERIOR ─────────────────────────────────── -->
<section class="inner-hero bg-light">
    <div class="container text-center py-5">
        <span class="section-tag">QUIÉNES SOMOS</span>
        <h1 class="fw-bold mt-2">Sobre MUDDUA</h1>
        <p class="text-muted mt-2">
            Conoce nuestra historia, lo que nos mueve y los valores<br />
            que guían cada proyecto que desarrollamos.
        </p>
        <nav aria-label="breadcrumb" class="mt-3">
            <ol class="breadcrumb justify-content-center">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index">Inicio</a>
                </li>
                <li class="breadcrumb-item active">Nosotros</li>
            </ol>
        </nav>
    </div>
</section>


<!-- ── HISTORIA ───────────────────────────────────────── -->
<section class="py-5">
    <div class="container">
        <div class="row align-items-center g-5">

            <div class="col-lg-5 fade-in">
                <div class="value-image">
                    <img src="/img/team/img2.jpg"
                         class="img-fluid rounded-4 shadow"
                         alt="Equipo MUDDUA" />
                </div>
            </div>

            <div class="col-lg-7 fade-in">
                <span class="section-tag">NUESTRA HISTORIA</span>
                <h2 class="fw-bold mt-1 mb-3">¿Cómo nació MUDDUA?</h2>
                <!-- ⚠️ REEMPLAZA con tu historia real -->
                <p class="text-muted" style="line-height:1.8;">
                    Nuestra historia comenzó con una filosofía clara: 
                    el software de excelencia es el resultado del equilibrio perfecto. 
                    MUDDUA se fundó bajo seis pilares fundamentales:  <strong>M</strong>ente, 
                    <strong>U</strong>nión, <strong>D</strong>iseño,
                    <strong>D</strong>esarrollo, <strong>U</strong>tilidad y <strong>A</strong>vance. 
                    Esta metodología nos ha permitido consolidarnos
                    como aliados estratégicos en el sector tecnológico, diseñando arquitecturas de 
                    vanguardia que eliminan barreras operativas y potencian el crecimiento digital.

                </p>
            </div>

        </div>
    </div>
</section>


<!-- ── MISIÓN · VISIÓN · VALORES ─────────────────────── -->
<section class="bg-light py-5">
    <div class="container">

        <div class="text-center mb-5">
            <span class="section-tag">IDENTIDAD CORPORATIVA</span>
            <h2 class="fw-bold mt-1">Misión, Visión y Valores</h2>
            <p class="text-muted">Los principios que guían cada línea de código que escribimos.</p>
        </div>

        <div class="row g-4">

            <!-- MISIÓN -->
            <div class="col-md-4 fade-in">
                <div class="mvv-card h-100 text-center">
                    <div class="card-icon icon-design mx-auto">
                        <i class="bi bi-bullseye"></i>
                    </div>
                    <h4 class="fw-bold mt-3">Misión</h4>
                    <p class="text-muted mt-5 text-justify" style="line-height:1.75;">
                        Brindar soluciones tecnológicas innovadoras y accesibles
                        mediante el desarrollo de software de calidad,
                        ayudando a empresas y emprendedores a mejorar
                        sus procesos y crecer en el mundo digital.
                    </p>
                </div>
            </div>

            <!-- VISIÓN -->
            <div class="col-md-4 fade-in">
                <div class="mvv-card h-100 text-center">
                    <div class="card-icon icon-dev mx-auto">
                        <i class="bi bi-eye-fill"></i>
                    </div>
                    <h4 class="fw-bold mt-3">Visión</h4>
                    <p class="text-muted mt-5 text-justify" style="line-height:1.75;">
                        Ser una empresa en desarrollo y gestión de software reconocida por
                        su innovación, confianza y compromiso, posicionándose como un
                        referente en el desarrollo de software a un nivel nacional.
                    </p>
                </div>
            </div>

            <!-- VALORES -->
            <div class="col-md-4 fade-in">
                <div class="mvv-card h-100">
                    <div class="card-icon icon-grow mx-auto">
                        <i class="bi bi-gem"></i>
                    </div>
                    <h4 class="fw-bold mt-3 text-center">Valores</h4>
                    <!-- ⚠️ REEMPLAZA con tus valores reales -->
                    <ul class="values-list mt-2">
                        <li class="text-justify">
                            <i class="bi bi-check2-circle text-primary"></i>
                            <span><strong>Responsabilidad</strong> — Entregas puntuales y garantizadas.</span>
                        </li>
                        <li>
                            <i class="bi bi-check2-circle text-success"></i>
                            <span><strong>Compromiso con el cliente</strong> — Tu éxito es nuestra prioridad.</span>
                        </li>
                        <li>
                            <i class="bi bi-check2-circle text-danger"></i>
                            <span><strong>Trabajo en equipo</strong> — Sinergia para mejores resultados.</span>
                        </li>
                        <li>
                            <i class="bi bi-check2-circle text-warning"></i>
                            <span><strong>Honestidad</strong> — Transparencia en cada proceso.</span>
                        </li>
                        <li>
                            <i class="bi bi-check2-circle text-info"></i>
                            <span><strong>Calidad</strong> — Excelencia en cada línea de código.</span>
                        </li>
                        <li>
                            <i class="bi bi-check2-circle text-info"></i>
                            <span><strong>Unión</strong> — Colaboración ante cualquier desafío.</span>
                        </li>
                    </ul>
                </div>
            </div>

        </div>
    </div>
</section>


<!-- ── OBJETIVOS ──────────────────────────────────────── -->
<section class="py-5">
    <div class="container">

        <div class="text-center mb-5">
            <span class="section-tag">LO QUE NOS MUEVE</span>
            <h2 class="fw-bold mt-1">Nuestros Objetivos</h2>
            <p class="text-muted">Las metas que perseguimos como equipo cada día.</p>
        </div>

        <div class="row g-4">
            <!-- ⚠️ Agrega o quita tarjetas según tus objetivos reales -->
            <div class="col-sm-6 col-lg-3 fade-in">
                <div class="goal-card text-center h-100">
                    <div class="goal-num">01</div>
                    <h6 class="fw-bold mt-2">Calidad de software</h6>
                    <p class="text-muted small">Entregas libres de errores, bien documentadas y fáciles de mantener.</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3 fade-in">
                <div class="goal-card text-center h-100">
                    <div class="goal-num">02</div>
                    <h6 class="fw-bold mt-2">Aprendizaje constante</h6>
                    <p class="text-muted small">Mantenernos actualizados con las tendencias tecnológicas del mercado.</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3 fade-in">
                <div class="goal-card text-center h-100">
                    <div class="goal-num">03</div>
                    <h6 class="fw-bold mt-2">Impacto real</h6>
                    <p class="text-muted small">Que cada solución genere valor tangible para nuestros clientes.</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3 fade-in">
                <div class="goal-card text-center h-100">
                    <div class="goal-num">04</div>
                    <h6 class="fw-bold mt-2">Crecimiento profesional</h6>
                    <p class="text-muted small">Construir carrera sólida a partir de proyectos reales.</p>
                </div>
            </div>
        </div>

    </div>
</section>


<!-- ── CTA ────────────────────────────────────────────── -->
<section class="bg-dark text-white py-5">
    <div class="container text-center">
        <h2 class="fw-bold">Conoce a las personas detrás de MUDDUA</h2>
        <p class="text-white-50 mt-2">Cada integrante aporta habilidades únicas y especializadas.</p>
        <a asp-controller="Home" asp-action="Equipo"
           class="btn btn-primary btn-muddua mt-4">
            <i class="bi bi-people-fill me-1"></i> Ver el equipo
        </a>
    </div>
</section>